// Module
___CSS_LOADER_EXPORT___.push([module.id, `#gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(20vw, 400px));
  justify-content: center;
  gap: 1em;
  padding: 12px;
}

.column {
  display: flex;
  flex-direction: column;
  width: clamp(20vw, 400px, 90vw);
  gap: 24px;
}

.gallery-pic {
  width: 100%;
  height: auto;
  box-shadow: -4px 4px 0 var(--secondary);
  border-radius: 2px;
  border: 1px solid var(--shadow);
}

.full-size {
  position: fixed;
  max-height: 95vh;
  width: auto;
  max-width: 95vw;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 48px var(--shadow);
}
