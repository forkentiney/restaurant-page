___CSS_LOADER_EXPORT___.push([module.id, `#profiles {
  flex-wrap: wrap;
  gap: 12em;
  p {
    width: clamp(290px, 20vw, 30vw);
  }
}

.profile {
  text-align: center;
  align-self: flex-start;
}

.profile-pic {
  width: clamp(290px, 20vw, 30vw);
  aspect-ratio: 1 / 1;
  border-radius: 100%;
  border: 1px solid var(--shadow);
  box-shadow: 0 0 12px var(--shadow);
  margin: 12px;
}

#aboutSection {
  display: flex;
  flex-direction: column;
  align-self: center;
  margin: 64px 24px;
  max-width: 100ch;
}
